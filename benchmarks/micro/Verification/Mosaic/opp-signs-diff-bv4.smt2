; Signed two-phase variant derived from Mosaic's opp-signs-diff workload.
(set-logic HORN)
(define-sort Word () (_ BitVec 4))
(declare-rel p (Word Word Word Word Word))
(declare-rel q (Word Word Word Word))
(declare-rel r (Word Word))
(declare-rel fail ())
(declare-var x Word)
(declare-var y Word)
(declare-var a Word)
(declare-var b Word)
(declare-var i Word)

(rule (=> (and (bvsgt x y) (bvsgt y (_ bv0 4)))
          (p x y (_ bv0 4) (_ bv0 4) (_ bv0 4))))
(rule (=> (and (p x y a b i) (bvslt i x))
          (p x y (bvadd a (_ bv1 4)) (bvsub b (_ bv1 4))
                 (bvadd i (_ bv1 4)))))
(rule (=> (and (p x y a b i) (not (bvslt i x)))
          (q y a b (_ bv0 4))))
(rule (=> (and (q y a b i) (bvslt i y))
          (q y (bvsub a (_ bv1 4)) (bvadd b (_ bv1 4))
               (bvadd i (_ bv1 4)))))
(rule (=> (and (q y a b i) (not (bvslt i y))) (r a b)))
(rule (=> (and (r a b) (not (bvslt (bvxor a b) (_ bv0 4)))) fail))
(query fail)
