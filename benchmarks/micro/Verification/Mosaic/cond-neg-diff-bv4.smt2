; Signed two-phase variant derived from cond-neg-diff.
(set-logic HORN)
(define-sort Word () (_ BitVec 4))
(declare-rel p (Word Word Word Word))
(declare-rel q (Word Word Word))
(declare-rel r (Word Word))
(declare-rel fail ())
(declare-var x Word)
(declare-var y Word)
(declare-var a Word)
(declare-var i Word)
(declare-var b Word)

(rule (=> (and (bvsgt x y) (bvsgt y (_ bv0 4)))
          (p x y (_ bv0 4) (_ bv0 4))))
(rule (=> (and (p x y a i) (bvslt i x))
          (p x y (bvsub a (_ bv1 4)) (bvadd i (_ bv1 4)))))
(rule (=> (and (p x y a i) (not (bvslt i x)))
          (q y a (_ bv0 4))))
(rule (=> (and (q y a i) (bvslt i y))
          (q y (bvadd a (_ bv1 4)) (bvadd i (_ bv1 4)))))
(rule (=> (and (q y a i) (not (bvslt i y)) (bvslt a (_ bv0 4)))
          (r a (_ bv1 4))))
(rule (=> (and (q y a i) (not (bvslt i y))
               (not (bvslt a (_ bv0 4))))
          (r a (_ bv0 4))))
(rule (=> (and (r a b)
               (not (bvsgt (bvadd (bvxor a (bvneg b)) b) (_ bv0 4))))
          fail))
(query fail)
