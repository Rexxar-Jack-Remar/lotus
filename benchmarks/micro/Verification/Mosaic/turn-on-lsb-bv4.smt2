; Signed least-significant-bit property derived from turn-on-lsb.
(set-logic HORN)
(define-sort Word () (_ BitVec 4))
(declare-rel p (Word Word))
(declare-rel q (Word Word Word))
(declare-rel r (Word Word))
(declare-rel fail ())
(declare-var x Word)
(declare-var y Word)
(declare-var a Word)
(declare-var b Word)

(rule (=> (bvsgt x (_ bv0 4)) (p x (_ bv0 4))))
(rule (=> (and (p x a) (bvslt a x))
          (p x (bvadd a (_ bv1 4)))))
(rule (=> (bvsgt x (_ bv0 4)) (q x x (_ bv0 4))))
(rule (=> (and (q x y b) (bvsgt y (_ bv0 4)))
          (q x (bvsub y (_ bv1 4)) (bvsub b (_ bv1 4)))))
(rule (=> (and (p x a) (not (bvslt a x))
               (q x y b) (not (bvsgt y (_ bv0 4))))
          (r a b)))
(rule (=> (and (r a b)
               (not (= (bvor (bvadd a b) (_ bv1 4)) (_ bv1 4))))
          fail))
(query fail)
