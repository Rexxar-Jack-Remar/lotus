; Signed conditional-negation property derived from cond-neg.
(set-logic HORN)
(define-sort Word () (_ BitVec 4))
(declare-rel p (Word Word Word))
(declare-rel q (Word Word))
(declare-rel fail ())
(declare-var x Word)
(declare-var y Word)
(declare-var i Word)
(declare-var b Word)

(rule (=> (and (bvsgt x y) (bvsgt y (_ bv0 4)))
          (p x y (_ bv0 4))))
(rule (=> (and (p x y i) (bvslt i y))
          (p x y (bvadd i (_ bv2 4)))))
(rule (=> (and (p x y i) (not (bvslt i y))) (q x i)))
(rule (=> (and (q x i)
               (= b (ite (bvsle i x) (_ bv1 4) (_ bv0 4)))
               (not (= (bvadd (bvxor x (bvneg b)) b) (bvneg x))))
          fail))
(query fail)
