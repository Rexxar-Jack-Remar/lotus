; Multi-phase unsigned query with auxiliary variables, derived from swap.
(set-logic HORN)
(define-sort Word () (_ BitVec 4))
(declare-rel p (Word Word Word Word))
(declare-rel q (Word Word Word))
(declare-rel r (Word Word))
(declare-rel fail ())
(declare-var x Word)
(declare-var y Word)
(declare-var a Word)
(declare-var b Word)
(declare-var a1 Word)
(declare-var b1 Word)

(rule (=> (and (bvugt x y) (bvugt y (_ bv0 4)))
          (p x y (_ bv0 4) (_ bv0 4))))
(rule (=> (and (p x y a b) (bvult b y))
          (p x y (bvadd a (_ bv1 4)) (bvadd b (_ bv1 4)))))
(rule (=> (and (p x y a b) (not (bvult b y))) (q x a b)))
(rule (=> (and (q x a b) (bvult a x))
          (q x (bvadd a (_ bv1 4)) b)))
(rule (=> (and (q x a b) (not (bvult a x))) (r a b)))
(rule (=> (and (r a b)
               (= a1 (bvxor a b))
               (= b1 (bvxor b a1))
               (not (bvult (bvxor a1 b1) b1)))
          fail))
(query fail)
