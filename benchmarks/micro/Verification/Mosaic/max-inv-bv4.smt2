; Unsigned, bit-manipulating query derived from Mosaic's max-inv workload.
(set-logic HORN)
(define-sort Word () (_ BitVec 4))
(declare-rel p (Word Word Word Word))
(declare-rel q (Word Word))
(declare-rel fail ())
(declare-var x Word)
(declare-var y Word)
(declare-var z Word)
(declare-var a Word)
(declare-var i Word)

(rule (=> (and (bvugt x y) (bvuge (bvsub x y) z))
          (p y z x (_ bv0 4))))
(rule (=> (and (p y z a i) (bvult i z))
          (p y z (bvsub a (_ bv1 4)) (bvadd i (_ bv1 4)))))
(rule (=> (and (p y z a i) (not (bvult i z))) (q y a)))
(rule (=> (and (q y a)
               (not (= a (bvxor a
                                 (bvand (bvxor a y)
                                        (ite (bvult a y)
                                             (bvnot (_ bv0 4))
                                             (_ bv0 4)))))))
          fail))
(query fail)
