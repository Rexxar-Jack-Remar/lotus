; Unsigned accumulation and xor swap derived from swap-sum.
(set-logic HORN)
(define-sort Word () (_ BitVec 4))
(declare-rel p (Word Word Word Word))
(declare-rel q (Word Word Word))
(declare-rel r (Word Word))
(declare-rel fail ())
(declare-var x Word)
(declare-var y Word)
(declare-var a Word)
(declare-var i Word)
(declare-var y1 Word)
(declare-var a1 Word)

(rule (=> (bvule y (bvsub (bvnot (_ bv0 4)) x))
          (p x y (_ bv0 4) (_ bv0 4))))
(rule (=> (and (p x y a i) (bvult i x))
          (p x y (bvadd a (_ bv1 4)) (bvadd i (_ bv1 4)))))
(rule (=> (and (p x y a i) (not (bvult i x)))
          (q x y (_ bv0 4))))
(rule (=> (and (q y a i) (bvult i y))
          (q y (bvadd a (_ bv1 4)) (bvadd i (_ bv1 4)))))
(rule (=> (and (q y a i) (not (bvult i y))) (r y a)))
(rule (=> (and (r y a)
               (= y1 (bvxor y a))
               (= a1 (bvxor a y1))
               (not (bvuge (bvxor y1 a1) a1)))
          fail))
(query fail)
