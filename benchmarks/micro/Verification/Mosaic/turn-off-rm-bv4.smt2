; Unsigned rightmost-set-bit property derived from turn-off-rm.
(set-logic HORN)
(define-sort Word () (_ BitVec 4))
(declare-rel p (Word Word Word))
(declare-rel q (Word))
(declare-rel fail ())
(declare-var x Word)
(declare-var y Word)
(declare-var z Word)

(rule (=> (bvugt x (_ bv0 4)) (p x (_ bv0 4) x)))
(rule (=> (and (p x y z) (bvult y (bvsub x (_ bv1 4))))
          (p x (bvadd y (_ bv1 4)) (bvsub z (_ bv1 4)))))
(rule (=> (and (p x y z)
               (not (bvult y (bvsub x (_ bv1 4)))))
          (q z)))
(rule (=> (and (q z)
               (not (= (bvand z (bvsub z (_ bv1 4))) (_ bv0 4))))
          fail))
(query fail)
